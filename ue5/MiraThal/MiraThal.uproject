{
	"FileVersion": 3,
	"EngineAssociation": "5.4",
	"Category": "Game",
	"Description": "Mira-Thal — 3D voxel narrative RPG (UE5 port of the Godot build). 10cm destructible voxel cubes via a custom cubic greedy mesher (MiraThalVoxel), Nanite/Lumen, Chaos physics, dedicated-server multiplayer.",
	"Modules": [
		{
			"Name": "MiraThalVoxel",
			"Type": "Runtime",
			"LoadingPhase": "PreDefault",
			"AdditionalDependencies": [ "Engine" ]
		},
		{
			"Name": "MiraThalCore",
			"Type": "Runtime",
			"LoadingPhase": "Default",
			"AdditionalDependencies": [ "Engine" ]
		},
		{
			"Name": "MiraThalNet",
			"Type": "Runtime",
			"LoadingPhase": "Default",
			"AdditionalDependencies": [ "Engine" ]
		}
	],
	"Plugins": [
		{
			"//comment": "No third-party voxel plugin. Voxel Plugin 2 dropped cubic terrain; the cubic spike (design/UE5_VOXEL_BACKEND_EVALUATION.md) found no off-the-shelf cubic backend meeting our bar, so MiraThalVoxel owns a custom cubic greedy mesher built on the engine-agnostic Core."
		},
		{
			"Name": "GeometryScripting",
			"Enabled": true,
			"//comment": "Procedural/dynamic mesh helpers for the custom cubic mesher (UProceduralMeshComponent / UDynamicMesh)."
		},
		{
			"Name": "ModelingToolsEditorMode",
			"Enabled": true
		},
		{
			"Name": "OnlineSubsystemSteam",
			"Enabled": true,
			"//comment": "Phase 4 multiplayer sessions. Safe to leave enabled earlier; sessions are only created in MiraThalNet."
		}
	]
}
