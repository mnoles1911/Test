[gd_resource type="ShaderMaterial" load_steps=2 format=3 uid="uid://b8w4tmh3xzw0a"]

[ext_resource type="Shader" path="res://assets/shaders/water.gdshader" id="1_water_shader"]

[resource]
render_priority = 0
shader = ExtResource("1_water_shader")

; v8 (2026-05-16): proper lit transparent water — surface sheen
; (Fresnel sky reflection + sun specular) that ALWAYS reads as water,
; plus real depth-driven alpha (shallow = see bottom, deep = opaque).
; Replaces the v6/v7 unshaded screen-composite that had no surface.

; --- SHARED LOOK (MUST equal water_horizon_material.tres) ---
shader_parameter/water_tint_color = Color(0.10, 0.30, 0.42, 1.0)
; deep_water_color 0.02,0.06,0.12 → 0.05,0.13,0.22. The near-black
; floor made LOD-seam water-shell slivers at chunk boundaries read as
; a harsh BLACK grid at distance (depth-fade maxes to this colour on
; edge-on fragments). A deep-but-not-black blue collapses that grid's
; contrast (and deep water reads richer). Tune toward darker if deep
; ocean should still go near-black up close.
shader_parameter/deep_water_color = Color(0.02, 0.06, 0.11, 1.0)
shader_parameter/sky_reflection_color = Color(0.55, 0.70, 0.85, 1.0)
; fresnel 3.0/1.0 → 5.0/0.5: v8 washed the far surface near-white (full
; sky reflection at grazing). 0.5 strength keeps a sheen without
; blowing out; power 5 reserves it for the steepest glance.
shader_parameter/fresnel_power = 5.0
shader_parameter/fresnel_strength = 0.5
shader_parameter/metallic_amount = 0.0
; roughness 0.08 → 0.55: glossy water threw a hard specular glint on
; every flat voxel face (blocky "bad lighting"). Higher roughness =
; soft, flatter Minecraft-ish water. Tune to taste.
shader_parameter/roughness_amount = 0.55

; --- DEPTH-FADE / V3 physical model (2026-05-19) ---
; ROOT CAUSE of the long tuning failure: these shader_parameter values
; OVERRIDE the shader's `uniform = default`, so every shader-default
; edit was inert at runtime. Tuning happens HERE.
;
; depth_fade_distance is now the CLARITY MASTER (divides the per-
; channel water_extinction): SMALLER = murkier / opaque sooner,
; bigger = clearer. ~0.5 pond · ~3 lake · ~12 ocean.
; 2026-05-19 murkier tune (was 0.5): lakes here go 5-15 m deep + ocean
; farther; 0.5 left seabed faintly visible at 10 m and at ~150 m
; grazing. 0.20 makes water reach near-opaque (~95% deep_water_color)
; by ~1.5 m of view-ray depth. Raise back toward 0.5 for clearer
; pond / sea-glass look; drop further for swamp/murk biome.
shader_parameter/depth_fade_distance = 0.20
; water_extinction (RGB, R≫G>B): the per-wavelength absorption that
; makes water grade clear→green→deep-blue with depth (real optics).
; 2026-05-19: was (0.85,0.30,0.18) — bumped uniformly + raised G/B so
; the dark band closes faster in all channels (green tail used to keep
; lakebed visible after red was gone).
shader_parameter/water_extinction = Color(1.60, 0.70, 0.40, 1.0)
; water_murk: 0=clear refraction, 1=fully tinted. 0.97 = body is
; essentially pure tint with only ~3% lakebed showing through
; refraction at the top-down (low-Fresnel) near band — was 0.85
; (15% lakebed leak; provably visible at the player's feet per math
; + screenshot 2026-05-19).
shader_parameter/water_murk = 0.97
; shallow_alpha = the MINIMUM surface opacity (gameplay floor).
; 0.95 = ~5% lakebed through alpha (was 0.85 → 15% leak). Combined
; with water_murk 0.97 this makes near top-down water read solid
; tinted blue (~95% tint + 4% sky + ~3% lakebed) instead of "I can
; see the sand". Tune down for more see-through-the-water clarity.
shader_parameter/shallow_alpha = 0.95

; --- REFLECTION (2026-05-19 root-cause: pale water was the Fresnel
; sky-reflection at grazing angles dominating a solid surface — magenta
; proof-of-life test confirmed the shader IS drawing the water; the
; "see-through" look was actually mostly-sky-coloured surface). Slash
; the reflection contribution so the body colour shows through at
; grazing instead of turning the water pale-sky.
; refl_amt = clamp(fresnel * reflection_strength + reflection_floor, 0,
; 0.5). Even at full grazing, max 50% sky → 50%+ body colour stays.
shader_parameter/reflection_strength = 0.25
shader_parameter/reflection_floor = 0.05

; --- V3 PHASE 3 shoreline foam (2026-05-20, tuned) ---
; Foam appears where the water column is thinner than foam_edge_dist.
; TWO knobs, different jobs (see water.gdshader L514-521):
;   foam_edge_dist = how FAR the band spreads from the shore edge into
;     deeper water — i.e. how many voxel Y-levels it climbs. This is
;     the band-WIDTH knob.
;   foam_strength  = how OPAQUE/white the foam paints WITHIN that band
;     (0 = invisible, 1 = solid). Does NOT change the spread.
; Testing: 2.5 over-cranked the band to ~6 voxel Y-levels. Dialed to
; 0.85 (~1/3) so it hugs the true shore edge. Nudge edge_dist for
; width, strength for opacity.
shader_parameter/foam_color = Color(0.92, 0.96, 1, 1)
shader_parameter/foam_edge_dist = 0.85
shader_parameter/foam_strength = 0.4

; --- FLOW-DRIVEN WAVE AMPLITUDE (2026-05-19) ---
; Zylann's fluid mesher writes UV.y = 0 (NOT 8 / idle) for static
; full-level water — confirmed by debug_mode 5 showing uniform cyan
; across a still pond rather than black. Our decode_flow therefore
; reads strength = 1.0 everywhere and drives the FBM wave-height
; perturbation at full amplitude on lakes that shouldn't be flowing
; → the pronounced "shimmer / fingerprint ripples" the designer
; reported. Drop the master amplitude so static lakes get subtle
; wavelets; real moving water (rivers, falls) still animates because
; the height delta scales with both amp and per-noise frequencies.
shader_parameter/flow_motion_strength = 0.25

; --- §2c LOD-seam side-face camouflage colour (2026-05-19) ---
; LOD-seam vertical fluid polygons were "flatter but too dark" with
; just water_tint_color (0.10,0.30,0.42). Brighten the tint base 1.7×
; and blend 30% sky_reflection_color so seam fragments visually merge
; into the lit top water instead of reading as dark stripes.
; side_color ≈ mix((0.17,0.51,0.71), (0.55,0.70,0.85), 0.30)
;            = (0.28, 0.57, 0.75) — bright mid-blue with sky lift.
; Raise side_sky_mix toward 0.5 if seams still read darker than the
; tops; raise side_tint_brighten toward 2.0 for more saturation.
shader_parameter/side_tint_brighten = 1.7
shader_parameter/side_sky_mix = 0.30

; --- LOD-SEAM SUPPRESSION DISTANCE GATE (2026-05-18 readability fix) ---
; The dark-grid side-face suppression now only acts at DISTANCE so it
; stops fading out the near shallow water you look straight down into.
; _near = metres before any suppression (near water fully readable);
; _far = metres to reach full suppression (distant seam slivers killed).
; If near shallow water still reads too faint top-down: raise _near
; (e.g. 40). If the distant dark grid creeps back: lower _far (e.g. 48).
shader_parameter/seam_suppress_near_m = 24.0
shader_parameter/seam_suppress_far_m = 64.0

; --- DEBUG (0 normal · 1 depth_t · 2 fresnel · 3 thickness) ---
shader_parameter/debug_mode = 0

; --- LEGACY (unused, kept for WaterFlowManager / caller compat) ---
shader_parameter/wind_dir = Vector2(1, 0)
shader_parameter/wind_strength = 0.5
