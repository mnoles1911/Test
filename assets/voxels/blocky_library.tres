[gd_resource type="VoxelBlockyLibrary" format=3]

[resource]
; Empty stub library — populated by tools/build_blocky_library.gd.
;
; To fill this library, in the Godot editor:
;   1. Open Script Editor (Ctrl+Shift+E or the panel button).
;   2. File → Open Script → res://tools/build_blocky_library.gd
;   3. File → Run (or Ctrl+Shift+X).
;
; The script populates 12 model entries (one per material in the
; VoxelMaterialRegistry) with per-face tile coordinates pointing at
; assets/voxels/texture_packs/default/atlas.png. Re-run any time the
; material list changes.
;
; This stub exists so World3D.tscn can reference the library file by
; path even before the script has run — the scene loads with empty
; terrain rather than failing on a missing dependency.
