[gd_resource type="SceneReplicationConfig" format=3 uid="uid://dplayerreplmp2"]

; SceneReplicationConfig for player nodes (Player3D + RemotePlayer).
;
; Both scenes use this same resource so the synced property set is
; identical across the local-authority path (Player3D) and the
; remote-puppet path (RemotePlayer). If we ever drift the configs
; apart, Godot drops sync packets silently — single source of truth
; here prevents that.
;
; Replicated properties (all paths relative to the player root):
;   .:global_position           Vector3, replicate_mode=on_change
;   .:rotation                  Vector3, replicate_mode=on_change
;                               (only Y matters in practice but full
;                               Vector3 keeps the wire format simple)
;
; Replication mode notes (Godot SceneReplicationConfig):
;   replication_mode_property[i] = 0 for never, 1 for always (every
;   tick), 2 for on_change (broadcast only when the value changes).
;   We use on_change (2) for both — at ~20Hz on movement that's
;   plenty for MP-2's "see each other walk" acceptance bar.
;
; What's intentionally NOT here yet (deferred to later milestones):
;   - anim_state (no animations on RemotePlayer in MP-2)
;   - crouching / sprinting / swimming flags (no visual difference yet)
;   - hp / endurance (authority-on-host, replicated via RPC in MP-4)

[resource]
properties/0/path = NodePath(".:global_position")
properties/0/spawn = true
properties/0/replication_mode = 2
properties/1/path = NodePath(".:rotation")
properties/1/spawn = true
properties/1/replication_mode = 2
