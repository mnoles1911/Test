# Build outputs
IsometricRPGMono/bin/
IsometricRPGMono/obj/
IsometricRPGMono/publish/

# Godot 4 editor cache (regenerated on open; machine-specific)
.godot/

# Claude Code session state (per-machine; logs, transcripts, agent caches)
.claude/

# Godot 4.4+ script UID sidecars (regenerated on open; commit noise for a
# solo project — Godot recreates them on file rename if missing)
*.uid

# macOS Finder metadata
.DS_Store
**/.DS_Store

# Zylann's Voxel Tools plugin — ~100 MB of cross-platform native binaries.
# Distributed via GitHub Releases, not the Godot Asset Library.
# See DESIGNER_TODO.md Section 1 and design/ART_PIPELINE.md → "Tool 2:
# Zylann's Voxel Tools" for the install steps. Each developer installs
# locally; we do NOT commit this to keep the repo small.
addons/zylann.voxel/

# GodotSteam GDExtension — per-platform Steamworks SDK binaries.
# Steamworks SSA forbids redistribution; each developer downloads from
# godotsteam.com themselves. See addons/godotsteam/INSTALL.md for steps.
# The .gdextension text config and INSTALL.md ARE tracked; the binaries
# and per-platform subdirs are not.
addons/godotsteam/linux/
addons/godotsteam/win64/
addons/godotsteam/macos/
addons/godotsteam/*.so
addons/godotsteam/*.dll
addons/godotsteam/*.dylib

# TTS audio output (rendered from scripts; manifests are kept)
# Keeps audio/dialogue/**/manifest.json tracked, ignores binary audio.
audio/dialogue/**/*.mp3
audio/dialogue/**/*.ogg
audio/dialogue/**/*.wav
audio/dialogue/_spend.log

# Local secrets (ElevenLabs API key, etc.) — never commit.
.env
.env.local

# Python cache (from tools/ scripts)
__pycache__/
*.pyc

# Copper Isles heightmap source — 268 MB EXR. The shipped game reads from
# the baked SQLite (`assets/voxel/copper_isles_baseline_v14.sqlite`); the
# EXR is only needed in the editor for re-bakes. Distributed out-of-band;
# see design/COPPER_ISLES_BAKE_NOTES.md for the re-bake workflow.
assets/heightmaps/copper_isles_heightmap.exr

# Per-developer bake output (regenerated by running BakeWorld.tscn).
# Reproducible from the EXR; can run hundreds of MB. Match all pipeline
# revisions of the baseline so future channel/format migrations don't
# need to touch this file.
assets/voxel/copper_isles_baseline*.sqlite

# C++ GDExtension build outputs. The source (extensions/*/src/) +
# SConstruct + godot-cpp submodule pointer ARE tracked; the compiled
# .dll / .so / .dylib / .a per-platform binaries are reproducible
# from source via `scons` and shouldn't bloat the repo. Mirrors the
# pattern used for Zylann + GodotSteam binaries above.
extensions/*/bin/

# Headless test-harness run logs (regenerated each run).
tools/headless/*.log
_renders/

# --- UE5 port (ue5/MiraThal) — generated / transient / large template content ---
ue5/MiraThal/Saved/
ue5/MiraThal/Intermediate/
ue5/MiraThal/Binaries/
ue5/MiraThal/DerivedDataCache/
ue5/MiraThal/.vs/
ue5/MiraThal/Plugins/*/Binaries/
ue5/MiraThal/Plugins/*/Intermediate/
ue5/MiraThal/Content/Untitled*
ue5/MiraThal/Content/__ExternalActors__/
ue5/MiraThal/Content/__ExternalObjects__/
ue5/MiraThal/Content/HLOD/
docs/index.bleve/

# Generated voxel preview map (1.3GB, regenerable via Scripts/setup_voxel_preview.py)
ue5/MiraThal/Content/Maps/VoxelPreview.umap
ue5/MiraThal/Saved/

# Source heightmaps (large EXR/PNG — track via Git LFS in production, not here)
ue5/MiraThal/Content/Heightmaps/
