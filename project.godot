; Engine configuration file.
; Generated for Godot 4.3.
; Edit via the Godot editor UI when possible — the editor keeps this valid.

config_version=5

[application]

config/name="Game One"
config/description="A 2.5D narrative RPG. Mira-Thal Trilogy, Game One."
config/features=PackedStringArray("4.3", "GL Compatibility")
config/run/main_scene="res://scenes/World.tscn"

[autoload]

; GameState is a singleton that lives for the entire game session.
; Every scene can read and write to it via GameState.variable_name.
GameState="*res://scripts/GameState.gd"

[display]

; Native resolution: 320x180 pixels.
; Godot scales this up to the monitor size using integer scaling.
; Result: crisp pixels, no blurring, regardless of screen size.
window/size/viewport_width=320
window/size/viewport_height=180
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[input]

; The "interact" action is used for the press-E trigger in World.tscn.
; Add more actions here as systems expand (attack, menu, cancel, etc.).
interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":69,"key_label":0,"unicode":101,"location":0,"echo":false,"script":null)
]
}

[rendering]

; GL Compatibility renderer works on the widest range of hardware.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

; Nearest-neighbor filtering keeps pixel art sharp (no bilinear blur).
textures/canvas_textures/default_texture_filter=0

; Snap all 2D positions and vertices to whole pixels.
; Prevents sub-pixel jitter when the player moves.
rendering/2d/snap/snap_2d_transforms_to_pixel=true
rendering/2d/snap/snap_2d_vertices_to_pixel=true
