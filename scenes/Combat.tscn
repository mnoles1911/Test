[gd_scene load_steps=2 format=3]

; The only external resource is the Combat.gd script on the root node.
[ext_resource type="Script" path="res://scripts/Combat.gd" id="1"]

; === LAYOUT OVERVIEW (all at 320x180 native resolution) ===
;
;  [ROLAND      HP 30/30]      [ASHFALLEN   HP 20/20]
;
;
;       [Player: green rect]           [Enemy: red rect]
;
;
;  [message text here]
;  [60px ][====timing bar 200px====][     ]
;         [=====BLOCK PROMPT=======]
;  [BONUS HIT!]
;
;  [ SPACE ] ATTACK
;  [ - - - ] ITEM (coming soon)
;

[node name="Combat" type="Node2D"]
script = ExtResource("1")

; Dark battle background — distinct from the cave world scene.
[node name="Background" type="ColorRect" parent="."]
offset_right = 320.0
offset_bottom = 180.0
color = Color(0.04, 0.04, 0.09, 1)

; Player placeholder sprite (green rectangle, left side).
[node name="PlayerSprite" type="ColorRect" parent="."]
offset_left = 40.0
offset_top = 72.0
offset_right = 80.0
offset_bottom = 136.0
color = Color(0.2, 0.75, 0.2, 1)

; Enemy placeholder sprite (red rectangle, right side).
[node name="EnemySprite" type="ColorRect" parent="."]
offset_left = 240.0
offset_top = 72.0
offset_right = 280.0
offset_bottom = 136.0
color = Color(0.75, 0.15, 0.15, 1)

; White overlay on the enemy — normally hidden, briefly shown by _flash_enemy().
[node name="EnemyFlash" type="ColorRect" parent="."]
offset_left = 240.0
offset_top = 72.0
offset_right = 280.0
offset_bottom = 136.0
color = Color(1, 1, 1, 0.85)
visible = false

; --- UI CanvasLayer: all HUD elements live here so they draw on top of sprites ---
[node name="UI" type="CanvasLayer" parent="."]
layer = 10

; --- Player status panel (top left) ---
[node name="PlayerPanel" type="Control" parent="UI"]
offset_right = 150.0
offset_bottom = 30.0

[node name="PlayerName" type="Label" parent="UI/PlayerPanel"]
offset_left = 5.0
offset_top = 4.0
offset_right = 145.0
offset_bottom = 14.0
theme_override_font_sizes/font_size = 8
text = "ROLAND"

[node name="HPLabel" type="Label" parent="UI/PlayerPanel"]
offset_left = 5.0
offset_top = 15.0
offset_right = 145.0
offset_bottom = 25.0
theme_override_font_sizes/font_size = 8
text = "HP  30 / 30"

; --- Enemy status panel (top right) ---
[node name="EnemyPanel" type="Control" parent="UI"]
offset_left = 170.0
offset_top = 0.0
offset_right = 315.0
offset_bottom = 30.0

[node name="EnemyName" type="Label" parent="UI/EnemyPanel"]
offset_left = 5.0
offset_top = 4.0
offset_right = 140.0
offset_bottom = 14.0
theme_override_font_sizes/font_size = 8
text = "ASHFALLEN"

[node name="HPLabel" type="Label" parent="UI/EnemyPanel"]
offset_left = 5.0
offset_top = 15.0
offset_right = 140.0
offset_bottom = 25.0
theme_override_font_sizes/font_size = 8
text = "HP  20 / 20"

; --- Action menu (bottom of screen, shown during PLAYER_TURN) ---
[node name="ActionMenu" type="Control" parent="UI"]
offset_left = 0.0
offset_top = 140.0
offset_right = 320.0
offset_bottom = 180.0

[node name="AttackLabel" type="Label" parent="UI/ActionMenu"]
offset_left = 80.0
offset_top = 4.0
offset_right = 280.0
offset_bottom = 14.0
theme_override_font_sizes/font_size = 8
theme_override_colors/font_color = Color(1, 1, 0.4, 1)
text = "[ SPACE ]  ATTACK"

[node name="ItemLabel" type="Label" parent="UI/ActionMenu"]
offset_left = 80.0
offset_top = 16.0
offset_right = 280.0
offset_bottom = 26.0
theme_override_font_sizes/font_size = 8
theme_override_colors/font_color = Color(0.5, 0.5, 0.5, 1)
text = "[ - - - ]  ITEM  (coming soon)"

; --- Timing bar (shown during ATTACK_TIMING) ---
; TimingBar is a Control acting as a local coordinate space for the bar children.
; Its position on screen: x=60, y=88, width=200, height=16.
; All children are positioned within this local space.
[node name="TimingBar" type="Control" parent="UI"]
offset_left = 60.0
offset_top = 88.0
offset_right = 260.0
offset_bottom = 104.0
visible = false

; Grey background of the full bar.
[node name="BarBackground" type="ColorRect" parent="UI/TimingBar"]
offset_right = 200.0
offset_bottom = 16.0
color = Color(0.2, 0.2, 0.2, 1)

; Green sweet spot zone (at local x=90, width=40).
; SWEET_SPOT_START = 90.0 and SWEET_SPOT_WIDTH = 40.0 in Combat.gd must match this.
[node name="SweetSpot" type="ColorRect" parent="UI/TimingBar"]
offset_left = 90.0
offset_top = 0.0
offset_right = 130.0
offset_bottom = 16.0
color = Color(0.2, 0.85, 0.2, 1)

; White indicator that sweeps from left to right.
; Combat.gd moves this by setting position.x each frame.
[node name="Indicator" type="ColorRect" parent="UI/TimingBar"]
offset_left = 0.0
offset_top = 0.0
offset_right = 3.0
offset_bottom = 16.0
color = Color(1, 1, 1, 1)

; --- Block prompt (shown during BLOCK_TIMING) ---
[node name="BlockPrompt" type="Label" parent="UI"]
offset_left = 55.0
offset_top = 88.0
offset_right = 265.0
offset_bottom = 100.0
theme_override_font_sizes/font_size = 9
theme_override_colors/font_color = Color(1, 0.7, 0.1, 1)
text = "►  PRESS SPACE TO BLOCK!  ◄"
visible = false

; --- Message label (shows combat log: damage dealt, prompts, etc.) ---
[node name="MessageLabel" type="Label" parent="UI"]
offset_left = 5.0
offset_top = 110.0
offset_right = 315.0
offset_bottom = 138.0
theme_override_font_sizes/font_size = 7
autowrap_mode = 3
text = ""

; --- Bonus hit label (hidden, briefly shown on a timing success) ---
[node name="BonusLabel" type="Label" parent="UI"]
offset_left = 105.0
offset_top = 62.0
offset_right = 215.0
offset_bottom = 74.0
theme_override_font_sizes/font_size = 9
theme_override_colors/font_color = Color(1, 1, 0.2, 1)
text = "BONUS HIT!"
visible = false
