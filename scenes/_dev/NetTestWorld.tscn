[gd_scene load_steps=8 format=3 uid="uid://dnettestworldmp2"]

; NetTestWorld.tscn — MP-2 acceptance scene.
;
; A flat dev arena: 50 m × 50 m grey plane, directional sun, ambient
; sky, and a PlayerSpawner that listens to MultiplayerManager. When
; this scene loads on each peer, the spawner instantiates one Player3D
; for the local peer and one RemotePlayer for each connected remote
; peer.
;
; The host transitions here from scenes/_dev/NetTest.tscn the instant
; their lobby is ready. The guest transitions here the instant they
; connect. Both end up in this same scene, both spawn into it, and
; both see each other's puppet walk around.
;
; Joins the "dev_scene" group via NetTestWorldBootstrap.gd so HUDOverlay
; / PauseMenu / JournalUI / SaveNotification stay dormant.
;
; PATH CONTRACT: every peer's spawner adds children at
; `NetTestWorld/Players/PlayerSpawner/Player_<peer_id>`. Identical
; paths across peers are required for MultiplayerSynchronizer to
; route packets correctly.

[ext_resource type="Script" path="res://scripts/_dev/NetTestWorldBootstrap.gd" id="1_bootstrap"]
[ext_resource type="Script" path="res://scripts/net/PlayerSpawner.gd" id="2_spawner"]
[ext_resource type="PackedScene" path="res://scenes/Player3D.tscn" id="3_player_local"]
[ext_resource type="PackedScene" path="res://scenes/player/RemotePlayer.tscn" id="4_player_remote"]

