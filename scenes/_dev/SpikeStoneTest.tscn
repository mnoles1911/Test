[gd_scene load_steps=6 format=3]

; SpikeStoneTest — Phase 0 spike scene, throwaway.
;
; Goal: confirm that the SpikeStoneGenerator C++ class loads, gets bound to
; a SpikeStoneGeneratorAdapter (GDScript extends VoxelGeneratorScript), and
; that Zylann's worker pool calls into the C++ side per chunk.
;
; Success: scene loads without errors; the Output panel prints lines of the
; form "SpikeStoneGenerator: filled chunk origin=... size=... lod=...";
; terrain renders something (textured stone if blocky_library has stone at
; material id 1; otherwise solid white/untextured cubes — still a success).
;
; Failure modes to look out for:
;   - Class not found: SpikeStoneGenerator -- the C++ extension didn't load.
;     Confirm extensions/voxel_gen/bin/ has the .dll for your platform and
;     voxel_gen.gdextension is at extensions/voxel_gen/.
;   - No prints, no terrain -- the adapter has no cpp_impl assigned.
;
; If terrain doesn't render but prints appear in the Output panel: the C++
; chain is fine; the issue is just the VoxelBlockyLibrary not having a
; stone entry at material id 1. Not a spike blocker.

[ext_resource type="Script" path="res://scripts/_dev/SpikeStoneGeneratorAdapter.gd" id="1_adapter_script"]
[ext_resource type="VoxelBlockyLibrary" path="res://assets/voxels/blocky_library.tres" id="2_blocky_library"]

[sub_resource type="Environment" id="Env_1"]
background_mode = 1
background_color = Color(0.2, 0.25, 0.3, 1)
ambient_light_source = 2
ambient_light_color = Color(1, 1, 1, 1)
ambient_light_energy = 0.8

[sub_resource type="SpikeStoneGenerator" id="cpp_impl_1"]
material_id = 1

[sub_resource type="VoxelGeneratorScript" id="adapter_1"]
script = ExtResource("1_adapter_script")
cpp_impl = SubResource("cpp_impl_1")

[sub_resource type="VoxelMesherBlocky" id="VoxelMesher_1"]
library = ExtResource("2_blocky_library")

[node name="SpikeStoneTest" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env_1")

[node name="VoxelLodTerrain" type="VoxelLodTerrain" parent="."]
; mesh_block_size = 16 (default) keeps chunks small so the spike completes
; quickly. We don't need the production 32-block size for proof of life.
lod_count = 4
lod_distance = 64.0
mesh_block_size = 16
run_stream_in_editor = false
generator = SubResource("adapter_1")
mesher = SubResource("VoxelMesher_1")
transform = Transform3D(0.166667, 0, 0, 0, 0.166667, 0, 0, 0, 0.166667, 0, 0, 0)

[node name="VoxelViewer" type="VoxelViewer" parent="VoxelLodTerrain"]
view_distance = 64

[node name="ObserverCamera" type="Camera3D" parent="."]
; Camera pulled back and elevated so the spike's stone region is visible.
; World scale on the terrain is 1/6 (6 voxels per metre); coordinates here
; are in world metres.
current = true
transform = Transform3D(1, 0, 0, 0, 0.707107, 0.707107, 0, -0.707107, 0.707107, 0, 30, 30)
fov = 60.0

[node name="DirectionalLight3D" type="DirectionalLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.7071, -0.7071, 0, 0.7071, 0.7071, 0, 50, 0)
light_energy = 0.8
