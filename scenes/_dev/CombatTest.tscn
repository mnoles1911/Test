[gd_scene format=3 uid="uid://dcombat3st1v1"]

; CombatTest.tscn — v1 combat dev arena.
;
; What this is:
;   A flat circular forest clearing with three placeholder goblins
;   arranged in a loose triangle. Roland spawns at one edge so you
;   walk INTO the clearing and the goblins detect you naturally.
;
;   Joins the "dev_scene" group via CombatTestBootstrap.gd so all
;   gameplay UI autoloads (HUDOverlay, PauseMenu, JournalUI,
;   SaveNotification) stay dormant during testing.
;
; Debug keys (wired in CombatTestBootstrap.gd):
;   F1 — toggle debug menu
;   R  — reset enemies (frees alive + corpses, respawns triangle)
;   Q  — quit
;   F8 — kill nearest goblin (60 dmg, charged-spear equivalent)
;   F9 — wound nearest goblin (30 dmg, light-spear equivalent)
;
; This scene exists so the combat / blood loop can be iterated on
; without blocking on World3D's bake state. When v1 ships, the same
; encounter can be re-authored at a chosen spot in World3D — the
; goblin scene itself is portable.
;
; HEADS UP: Godot strips top-of-file comments when it re-emits a
; scene from the editor (e.g. after opening + saving). If these
; vanish again, restore from git history.

[ext_resource type="Script" uid="uid://donur323x6b4y" path="res://scripts/_dev/CombatTestBootstrap.gd" id="1_bootstrap"]
[ext_resource type="PackedScene" uid="uid://dgoblin01v1" path="res://scenes/enemies/Goblin.tscn" id="2_goblin"]
[ext_resource type="PackedScene" uid="uid://dp3l1roland3d" path="res://scenes/Player3D.tscn" id="3_player"]

[sub_resource type="ProceduralSkyMaterial" id="ProceduralSkyMaterial_1"]
sky_horizon_color = Color(0.7, 0.55, 0.35, 1)
ground_horizon_color = Color(0.5, 0.4, 0.25, 1)

[sub_resource type="Sky" id="Sky_1"]
sky_material = SubResource("ProceduralSkyMaterial_1")

[sub_resource type="Environment" id="Environment_1"]
; Warm afternoon palette to match the forest-battle concept-art mood.
; Light fog gives distance falloff so the placeholder ground doesn't
; read as an infinite plane. Saturated red blood pools pop against
; the desaturated browns and oranges baked in here.
background_mode = 2
sky = SubResource("Sky_1")
ambient_light_source = 3
ambient_light_color = Color(0.55, 0.5, 0.45, 1)
ambient_light_energy = 0.5
ssao_enabled = true
ssao_intensity = 1.5
fog_enabled = true
fog_light_color = Color(0.7, 0.6, 0.5, 1)
fog_density = 0.005

[sub_resource type="BoxShape3D" id="BoxShape3D_ground"]
size = Vector3(60, 0.5, 60)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_ground"]
; Forest-floor brown (#6E5233) — slightly desaturated so saturated
; red blood pools pop against it.
albedo_color = Color(0.43, 0.32, 0.2, 1)

[sub_resource type="PlaneMesh" id="PlaneMesh_ground"]
size = Vector2(60, 60)

