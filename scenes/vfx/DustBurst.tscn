[gd_scene load_steps=7 format=3 uid="uid://ddustburst01"]

; DustBurst.tscn — terrain-impact dust puff.
;
; Pre-instantiated by BloodVFX autoload (8 in the pool). Spawned
; whenever a spear or projectile hits non-enemy geometry.
;
; Smaller and fewer particles than blood burst, with weaker downward
; gravity (dust hangs in the air briefly). Tan color.

[sub_resource type="Gradient" id="Gradient_dust"]
; Tan dust → fade to off-white grey as particles age.
offsets = PackedFloat32Array(0.0, 0.6, 1.0)
colors = PackedColorArray(0.72, 0.59, 0.48, 1, 0.65, 0.55, 0.45, 1, 0.6, 0.55, 0.5, 1)

[sub_resource type="GradientTexture1D" id="GradientTexture1D_dust"]
gradient = SubResource("Gradient_dust")

[sub_resource type="Curve" id="Curve_dust_alpha"]
; Dust fades smoothly across full lifetime — no plateau hold.
min_value = 0.0
max_value = 1.0
_data = [Vector2(0, 0.85), 0.0, 0.0, 0, 0, Vector2(1, 0), 0.0, 0.0, 0, 0]
point_count = 2

[sub_resource type="ParticleProcessMaterial" id="ParticleProcessMaterial_dust"]
