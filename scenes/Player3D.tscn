[gd_scene load_steps=14 format=3 uid="uid://dp3l1roland3d"]

; Player3D — the 3D Roland scene.
;
; Hierarchy:
;   Player3D       (CharacterBody3D, root, runs Player3D.gd)
;   ├── Collision  (CollisionShape3D — capsule, 0.4m radius, 1.8m tall)
;   ├── Visual     (MeshInstance3D — green box placeholder, 0.4×1.8×0.25 m)
;   └── CameraTarget (Node3D — raised to chest height, 1.5m)
;       └── SpringArm3D (CameraRig.gd — 6m arm, 15° elevation)
;           └── Camera3D (the actual camera, looks back down the arm)
;
; Roland is 1.8 m tall — at the locked 6 vox/m terrain scale that's
; ~11 voxels of height. Capsule centre sits at Y=0.9 (half-height).
; When the Blender model lands, replace the MeshInstance3D with
; the imported .glb scene.

[ext_resource type="Script" path="res://scripts/Player3D.gd" id="1_player"]
[ext_resource type="Script" path="res://scripts/CameraRig.gd" id="2_rig"]
[ext_resource type="Script" path="res://scripts/EditToolHandler.gd" id="3_edit_tool"]
[ext_resource type="Script" path="res://scripts/ThrowableHandler.gd" id="4_throwable"]
[ext_resource type="Script" path="res://scripts/UnderwaterFilter.gd" id="5_underwater"]
[ext_resource type="ShaderMaterial" uid="uid://b8uwoverlay001" path="res://assets/shaders/underwater_overlay_material.tres" id="7_uw_overlay"]
[ext_resource type="Script" path="res://scripts/MeleeHandler.gd" id="8_melee"]

[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_1"]
radius = 0.4
height = 1.8

[sub_resource type="BoxMesh" id="BoxMesh_1"]
; Realistic adult silhouette: 0.4 m wide × 1.8 m tall × 0.25 m deep.
; At 6 vox/m (16.7 cm cubes), Roland covers ~11 voxels of height and
; ~2.4 voxels of shoulder width — proportions read as a person rather
; than a column of cubes.
size = Vector3(0.4, 1.8, 0.25)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_1"]
albedo_color = Color(0.2, 0.8, 0.2, 1)

; --- Sword + Shield placeholder meshes (Phase 1, Directional Melee v1) ---
; Long thin box clearly reads as a sword silhouette; flat square as a
; shield. Origin sits at the grip end of the sword (so rotations pivot
; around Roland's hand) and at the shield's center for the shield.
; Materials use the iron palette from Voxelmark to match the rest of
; Roland's HUD chrome.

[sub_resource type="BoxMesh" id="SwordMesh_1"]
; Blade dimensions: 8 cm wide × 100 cm long × 2 cm thick. Pivot is at
; the BOTTOM of the blade (handle end) — translated up by half-length
; in the parent's transform.
size = Vector3(0.08, 1.0, 0.02)

[sub_resource type="StandardMaterial3D" id="SwordMat_1"]
albedo_color = Color(0.78, 0.80, 0.85, 1)
metallic = 0.9
roughness = 0.25
emission_enabled = true
emission = Color(0.5, 0.55, 0.6, 1)
emission_energy_multiplier = 0.08

[sub_resource type="BoxMesh" id="ShieldMesh_1"]
; Round-ish shield approximated by a flat box: 50 cm wide × 60 cm tall
; × 5 cm thick. Pivot at center so directional rotations sweep cleanly.
size = Vector3(0.5, 0.6, 0.05)

[sub_resource type="StandardMaterial3D" id="ShieldMat_1"]
albedo_color = Color(0.43, 0.32, 0.20, 1)
metallic = 0.2
roughness = 0.6
emission_enabled = true
emission = Color(0.30, 0.22, 0.14, 1)
emission_energy_multiplier = 0.05

[sub_resource type="BoxShape3D" id="MeleeHitbox_1"]
; Hitbox roughly the volume the sword sweeps through. Used as a probe
; volume only — MeleeHandler does its own cone overlap math; this Area3D
; exists for future contact-physics use (e.g. mid-swing collision with a
; wall to cancel a swing).
size = Vector3(0.6, 0.6, 1.0)

; --- C3: underwater particulates (drifting motes/specks visible while
; submerged). Slow upward drift in world space (local_coords=false so
; particles don't stick to the player as they swim), small quads with
; soft additive-ish emission so they read in dark water. Toggled by
; UnderwaterFilter.set_active via .emitting (not .visible) so existing
; specks finish their lifetime gracefully when emerging.

[sub_resource type="QuadMesh" id="ParticulateMesh_1"]
size = Vector2(0.04, 0.04)

[sub_resource type="StandardMaterial3D" id="ParticulateMat_1"]
shading_mode = 0
transparency = 1
billboard_mode = 1
billboard_keep_scale = true
albedo_color = Color(0.75, 0.88, 1.0, 0.55)
emission_enabled = true
emission = Color(0.6, 0.78, 1.0, 1.0)
emission_energy_multiplier = 0.6

[sub_resource type="ParticleProcessMaterial" id="ParticulateProc_1"]
emission_shape = 1
emission_sphere_radius = 8.0
direction = Vector3(0.0, 1.0, 0.0)
spread = 45.0
; Designer pass 2026-05-20: v1 init 0.02-0.08 + damping 0.4-0.9 made
; motes effectively stop within 1 second of spawning ("imperceptible
; drift, despawn, respawn elsewhere"). Faster init + near-zero damping
; + meaningful upward current so they visibly travel a few metres over
; their lifetime. Turbulence cranked so the drift swirls instead of
; reading as straight-line trajectories.
initial_velocity_min = 0.05
initial_velocity_max = 0.20
gravity = Vector3(0.0, 0.06, 0.0)
damping_min = 0.0
damping_max = 0.1
scale_min = 0.4
scale_max = 1.0
turbulence_enabled = true
turbulence_noise_strength = 0.20
turbulence_noise_speed = Vector3(0.2, 0.1, 0.2)

; --- C18: bubble BURST on water transition (one-shot splash particles,
; Minecraft-style). Fires on EVERY set_active flip (submerge AND emerge)
; to mask the instant fog/colour snap. local_coords=false so the burst
; stays in world-space at the player's crossing position even if they
; keep moving. Distinct from UnderwaterParticulates (continuous drift)
; — this is a one-shot ~0.8s puff of ~40 bubbles around the camera.

[sub_resource type="SphereMesh" id="BubbleMesh_1"]
; Small spherical bubble. 3D mesh (not billboard quad) so the lighting
; gives it a subtle highlight as it rises — reads as a real bubble.
radius = 0.03
height = 0.06
radial_segments = 6
rings = 3

[sub_resource type="StandardMaterial3D" id="BubbleMat_1"]
shading_mode = 0
transparency = 1
albedo_color = Color(0.9, 0.95, 1.0, 0.7)
emission_enabled = true
emission = Color(0.75, 0.85, 1.0, 1.0)
emission_energy_multiplier = 0.8
metallic = 0.0
roughness = 0.1

[sub_resource type="ParticleProcessMaterial" id="BubbleProc_1"]
; Small sphere of emission around the camera/head, bubbles rise
; upward against (anti-)gravity — buoyancy makes them float UP.
emission_shape = 1
emission_sphere_radius = 0.5
direction = Vector3(0.0, 1.0, 0.0)
spread = 70.0
initial_velocity_min = 0.8
initial_velocity_max = 2.5
gravity = Vector3(0.0, 2.5, 0.0)
damping_min = 0.3
damping_max = 0.8
scale_min = 0.6
scale_max = 1.4
; Slight turbulence so bubbles don't rise in perfect lines.
turbulence_enabled = true
turbulence_noise_strength = 0.4
turbulence_noise_speed = Vector3(1.0, 0.5, 1.0)

[node name="Player3D" type="CharacterBody3D" groups=["player"]]
script = ExtResource("1_player")

[node name="Collision" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
shape = SubResource("CapsuleShape3D_1")

[node name="Visual" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
mesh = SubResource("BoxMesh_1")
surface_material_override/0 = SubResource("StandardMaterial3D_1")

[node name="CameraTarget" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.5, 0)

[node name="SpringArm3D" type="SpringArm3D" parent="CameraTarget"]
; Settled at 6 m after testing 5 m (player looked huge) and 8 m
; (camera felt detached). 6 m frames Roland clearly while keeping
; ~3 m of surrounding terrain on each side. Player can still scroll
; the wheel to zoom in to 2 m or out to 10 m at runtime.
spring_length = 6.0
script = ExtResource("2_rig")
elevation_degrees = 15.0
arm_length = 6.0

[node name="Camera3D" type="Camera3D" parent="CameraTarget/SpringArm3D"]
current = true

[node name="VoxelViewer" type="VoxelViewer" parent="."]
; Tells the voxel terrain which area to stream around the player.
; Without this node, the VoxelLodTerrain in World3D won't know where
; to load chunks. Position is the player's world position; the
; terrain streams chunks within `view_distance` of this node.
;
; History:
;   3000 voxels (500 m): worker threads perpetually behind on the M5
;     test world, near LOD0 took seconds to resolve.
;   1500 voxels (250 m): solved streaming starvation but cut horizon
;     too short for the Copper Isles 5 km vista.
;   6000 voxels (1 km): brought the archipelago into view but the
;     mountaintop still saw the world cut off short of the far edge.
;   12000 voxels (2 km): covers most of the 5 km Copper Isles map
;     from any vantage but pegged streaming hard.
;   8000 voxels (1.33 km): trades ~30 % less voxel volume to stream
;     for tighter performance. The static HorizonSkirt covers the
;     2-5 km band as a single static mesh + atmospheric fog hides
;     the seam between voxel terrain and skirt.
;   16000 voxels (2.67 km): pairs with lod_count=10 + CLIPBOX
;     streaming. CLIPBOX is more efficient than the legacy octree at
;     scale, and 10 LOD levels cover the whole pyramid out to
;     ~10.9 km — most of which falls outside view_distance and
;     never streams, but the bands within view (LOD0-7) provide
;     graceful detail-fall to the horizon.
;   8000 voxels (1.33 km): cut 2026-05-07 to reduce main-thread
;     mesh-upload + collision-rebuild churn during fast movement.
;     The HorizonSkirt + horizon plane cover everything past this
;     radius. Bump up if a vista needs more voxel-rendered terrain
;     at the cost of movement framerate.
;
;   2700 voxels (~450 m): cut 2026-05-22 for the DistantTerrain LOD
;     overhaul — but this still streamed a huge coarse-LOD3 annulus
;     (lod_count 4 only LOD-covers ~1024 voxels), the real cause of the
;     10-15 s LOD resolve times.
;   1100 voxels (~183 m): cut 2026-05-22 — matched to lod_count 4's
;     actual LOD coverage (LOD3 outer ~1024 voxels) so NO wasteful
;     coarse annulus streams. ~5x fewer chunks: the near band resolves
;     fast and the (Zylann-capped 21 m) LOD0 ring tracks the player.
;     DistantTerrainManager's smooth heightmesh covers everything past
;     it. Tune with F12 — push higher for a bigger blocky band at a
;     streaming cost; a small coarse annulus past 1024 voxels is
;     tolerable, the 1024-2700 one was not.
;
; Raise in the F1 DebugOverlay "View Distance" sub-view if you want
; more visible distance (at the cost of streaming load).
view_distance = 1100

[node name="EditToolHandler" type="Node3D" parent="."]
; Handles "swing tool, edit voxel" input. Reads the equipped weapon
; from InventoryManager; if it is an axe / pickaxe / shovel, ray
; casts forward from the camera, removes the targeted voxel via
; VoxelEditManager, and yields raw material into the inventory.
; See scripts/EditToolHandler.gd.
script = ExtResource("3_edit_tool")

[node name="ThrowableHandler" type="Node3D" parent="."]
; Handles throw input for throwable items (Powder Charges, future
; smoke bombs / oil flasks / caltrops). On the throw input
; (default: quick_slot_1 = key 1), spawns a throwable in front of
; Roland with forward velocity. Quick-slot UI rotation comes later.
; See scripts/ThrowableHandler.gd.
script = ExtResource("4_throwable")

[node name="MeleeHandler" type="Node3D" parent="."]
; Handles directional melee input — LMB swing (4 directions sampled from
; mouse motion), RMB parry tap / block hold. Only active when the equipped
; weapon's type is "melee_weapon" (sword); EditToolHandler short-circuits
; in that case so the same LMB does the right thing whether Roland has a
; tool, a thrown weapon, or a sword in hand. See scripts/MeleeHandler.gd.
script = ExtResource("8_melee")

[node name="MeleeWeaponPivot" type="Node3D" parent="."]
; Sword grip pivot. Positioned at Roland's right hand (X=+0.35 from
; pivot, Y=1.2 ≈ chest height, Z=-0.2 slightly forward). The sword
; mesh sits as a child of this pivot, translated up by half its length
; so the GRIP end is at the pivot — that way directional swings rotate
; the blade around the grip, the way a real swing pivots from the wrist.
; MeleeHandler tweens this node's transform per swing direction.
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.35, 1.2, -0.2)

[node name="SwordVisual" type="MeshInstance3D" parent="MeleeWeaponPivot"]
; Blade translated up by 0.5 m so the bottom edge (grip) sits at the
; pivot's origin. Pre-tilted forward 15° so it reads as "held ready"
; in the idle/home pose (a sword pointed straight up looks awkward).
transform = Transform3D(0.9659, 0.2588, 0, -0.2588, 0.9659, 0, 0, 0, 1, 0, 0.5, 0)
mesh = SubResource("SwordMesh_1")
surface_material_override/0 = SubResource("SwordMat_1")

[node name="MeleeWeaponHitbox" type="Area3D" parent="MeleeWeaponPivot"]
; Hitbox stub. MeleeHandler does its own cone overlap math (which is
; cheaper and direction-aware), but the Area3D is here so future
; mid-swing collision queries (sword vs wall to cancel a swing) have
; a place to live without restructuring.
collision_layer = 0
collision_mask = 1
monitorable = true
monitoring = true

[node name="CollisionShape3D" type="CollisionShape3D" parent="MeleeWeaponPivot/MeleeWeaponHitbox"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.5, -0.5)
shape = SubResource("MeleeHitbox_1")

[node name="ShieldPivot" type="Node3D" parent="."]
; Shield pivot. Positioned at Roland's left hand (X=-0.35), held forward
; and slightly out from his body at ~chest height. The shield faces
; FORWARD (-Z) at rest so the front face is visible in third-person
; over-shoulder; MeleeHandler rotates this node to angle the shield
; toward the matched block direction during RMB hold.
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.35, 1.0, -0.25)

[node name="ShieldVisual" type="MeshInstance3D" parent="ShieldPivot"]
; Shield centered on the pivot. No additional offset — origin = center
; of shield face = where it pivots when tilted up / left / right.
mesh = SubResource("ShieldMesh_1")
surface_material_override/0 = SubResource("ShieldMat_1")

[node name="UnderwaterFilter" type="CanvasLayer" parent="."]
; Full-screen blue-green tint shown when Roland's head is below
; the water surface. Player3D toggles via set_active() on submersion
; state changes. Layer 4 puts it above world but below HUD (layer 5).
; See scripts/UnderwaterFilter.gd.
layer = 4
script = ExtResource("5_underwater")

[node name="TintRect" type="ColorRect" parent="UnderwaterFilter"]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
visible = false
; .color is the fallback if the screen-wobble shader fails to compile
; on a given GPU. The shader (when bound) writes COLOR directly and
; ignores this property.
color = Color(0.18, 0.32, 0.42, 0.10)
material = ExtResource("7_uw_overlay")

[node name="UnderwaterParticulates" type="GPUParticles3D" parent="." groups=["underwater_particulates"]]
; Drifting specks visible while submerged. UnderwaterFilter toggles
; .emitting on submerge so existing particles finish gracefully when
; the player surfaces (no abrupt pop). local_coords=false means the
; emission ORIGIN moves with the player (so motes always emit near
; them) but the particles themselves live in world space and stay
; behind as the player swims forward — exactly the "I'm moving through
; them" feel.
amount = 200
lifetime = 10.0
emitting = false
local_coords = false
visibility_aabb = AABB(-12, -12, -12, 24, 24, 24)
process_material = SubResource("ParticulateProc_1")
draw_pass_1 = SubResource("ParticulateMesh_1")
material_override = SubResource("ParticulateMat_1")

[node name="BubbleBurst" type="GPUParticles3D" parent="." groups=["underwater_bubble_burst"]]
; One-shot bubble burst on every water-surface crossing (submerge OR
; emerge). UnderwaterFilter calls .restart() in set_active when state
; flips, which re-fires the burst from frame 0. one_shot=true makes
; the emission self-terminate after `amount` particles. Position
; offset (Y=+1.5) puts the burst at the camera/head height.
amount = 40
lifetime = 0.9
one_shot = true
emitting = false
local_coords = false
explosiveness = 0.9
randomness = 0.5
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.5, 0)
visibility_aabb = AABB(-3, -3, -3, 6, 6, 6)
process_material = SubResource("BubbleProc_1")
draw_pass_1 = SubResource("BubbleMesh_1")
material_override = SubResource("BubbleMat_1")
