[sub_resource type="VoxelMesherCubes" id="VoxelMesher_Cubes"]
; Renders one cube per solid voxel — the look the design doc calls
; "blocky stepped terrain, matches MagicaVoxel building style"
; (CLAUDE.md → Art specification → Terrain).
;
; color_mode = 0 (COLOR_RAW): each voxel's CHANNEL_COLOR value is a
; packed RGBA8888 read directly. Default mode is palette-indexed,
; which would interpret our packed RGBA as palette indices and
; produce monocolor cubes regardless of what we wrote.
color_mode = 0

