[node name="WaterVolume_Test" parent="." unique_id=1135040027 instance=ExtResource("5_water")]
; Small test pond — kept from the swimming batch so we can verify the
; small/local-water path still works alongside the ocean. ~10×3×10 m,
; tucked away from the central spawn area.
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -18, 0, 4)

[node name="OceanVolume" parent="." unique_id=2000000010 instance=ExtResource("6_ocean")]
; The OCEAN. Dedicated 200×30×200 m water volume centered at the
; world origin. Sea level is Y=0, so any voxel terrain lower than
; that is submerged. surface_y=0 inside the ocean scene. Roland walks
; in from the beach and starts swimming as soon as his head drops
; below Y=0.

[node name="Player3D" parent="." unique_id=1627586586 instance=ExtResource("1_player")]
; Spawn 10m above world origin. With the scaled voxel terrain peaking
; near Y=+5 m and the ocean at Y=0 m, this drops Roland into the air
; just above the highest hills — gravity settles him onto solid ground
; within a second or two.
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 10, 0)
