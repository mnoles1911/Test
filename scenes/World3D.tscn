[node name="VoxelLodTerrain" type="VoxelLodTerrain" parent="." unique_id=2000000001]
; The destructible voxel terrain. Replaces the prior flat StaticBody3D
; floor — physics collision is provided by the terrain itself at LOD0.
;
; If Roland falls through, check that:
;   1. VoxelGenerator has produced solid voxels at his spawn point
;   2. generate_collisions is true on this node (default)
;   3. The Player3D scene has a VoxelViewer child (it does, per Player3D.tscn)
generator = SubResource("VoxelGen_Flat")
mesher = SubResource("VoxelMesher_Cubes")
stream = SubResource("VoxelStream_SQLite")
lod_count = 6

