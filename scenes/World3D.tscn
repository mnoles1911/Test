[node name="WaterVolume_Test" parent="." instance=ExtResource("5_water")]
; Test pond — sits offset from spawn so the developer can walk
; into it. Surface is at Y=1.5 (the water_volume.tscn default).
; The Area3D extends 1.5m below origin, so submerged depth is
; reachable just by walking in.
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -8, 0, 4)

