[sub_resource type="BoxShape3D" id="TriggerShape"]
size = Vector3(2, 2, 2)

[sub_resource type="VoxelGeneratorFlat" id="VoxelGen_Flat"]
; A flat voxel surface at Y=0. Simplest possible test generator —
; gives us a walkable plane of voxels to verify the destructible
; pipeline works. Swap to VoxelGeneratorNoise (bumpy terrain) or
; VoxelGeneratorGraph (real Mira terrain via Gaea EXR) later.
height = 0
voxel_type = 1

[sub_resource type="VoxelMesherCubes" id="VoxelMesher_Cubes"]
; Blocky, stepped meshing — visible cube faces. Required for the
; intended look (matches MagicaVoxel building style). Do NOT swap
; to VoxelMesherTransvoxel — that smooths the geometry and kills
; the aesthetic.

[sub_resource type="VoxelStreamSQLite" id="VoxelStream_SQLite"]
; Stores every player edit as a delta against the procedural
; baseline. Hardcoded path for this prototype; multi-slot support
; (per-save-slot directories) is a follow-up — see
; design/SAVE_SYSTEM.md.
database_path = "user://voxel_deltas.sqlite"

[sub_resource type="BoxShape3D" id="NoEditZone_TestShape"]
size = Vector3(10, 10, 10)

