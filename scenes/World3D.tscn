[sub_resource type="ProceduralSkyMaterial" id="Sky_1"]
sky_top_color = Color(0.05, 0.06, 0.1, 1)
sky_horizon_color = Color(0.08, 0.08, 0.12, 1)
ground_bottom_color = Color(0.02, 0.02, 0.03, 1)
ground_horizon_color = Color(0.05, 0.04, 0.04, 1)

[sub_resource type="Sky" id="SkyResource_1"]
sky_material = SubResource("Sky_1")

[sub_resource type="Environment" id="Environment_1"]
background_mode = 2
sky = SubResource("SkyResource_1")
ambient_light_source = 3
ambient_light_color = Color(0.1, 0.12, 0.18, 1)
ambient_light_energy = 0.4
ssao_enabled = true
ssao_radius = 1.5
ssao_intensity = 1.5
fog_enabled = true
fog_light_color = Color(0.06, 0.07, 0.1, 1)
fog_density = 0.02

[sub_resource type="VoxelStreamSQLite" id="VoxelStream_SQLite"]
database_path = "user://voxel_deltas.sqlite"

[sub_resource type="FastNoiseLite" id="TerrainNoise"]
; Lower frequency = larger features. At voxel-grid coords (1 voxel = 1
; grid unit), 0.006 puts hill peaks roughly every 50-80 voxels (~6-10m
; in world units after the 0.125 terrain scale). Ridged fractal with
; 5 octaves gives sharp ridgelines + soft valleys.
frequency = 0.006
fractal_type = 2
fractal_octaves = 5
fractal_lacunarity = 2.1

[sub_resource type="CubicHeightmapGenerator" id="VoxelGen_Cubic"]
; Custom heightmap generator that writes the TYPE channel so
; VoxelMesherCubes can render hard-edged blocks (no Transvoxel
; smoothing). Each solid voxel becomes one cube. See
; scripts/CubicHeightmapGenerator.gd for the per-block fill loop.
noise = SubResource("TerrainNoise")
height_range_voxels = 80.0
sea_level_voxels = 0

[sub_resource type="VoxelMesherCubes" id="VoxelMesher_Cubes"]
; Renders one cube per solid voxel — the look the design doc calls
; "blocky stepped terrain, matches MagicaVoxel building style"
; (CLAUDE.md → Art specification → Terrain). Reads CHANNEL_TYPE.

[sub_resource type="BoxMesh" id="CampfireMesh"]
size = Vector3(0.5, 0.3, 0.5)

[sub_resource type="StandardMaterial3D" id="CampfireMat"]
albedo_color = Color(0.91, 0.53, 0.23, 1)
emission_enabled = true
emission = Color(1, 0.55, 0.25, 1)
emission_energy_multiplier = 1.5

[sub_resource type="BoxShape3D" id="TriggerShape"]
size = Vector3(2, 2, 2)

[sub_resource type="BoxShape3D" id="NoEditZone_TestShape"]
size = Vector3(10, 10, 10)

[node name="World3D" type="Node3D" unique_id=433411702]
script = ExtResource("4_bootstrap")

[node name="WorldEnvironment" type="WorldEnvironment" parent="." unique_id=1612514652]
environment = SubResource("Environment_1")

[node name="DayNightCycle" type="Node" parent="." unique_id=2000000021]
; Drives Sun, Moon, and sky colors from WorldClock each frame. Sees
; its three siblings via NodePath defaults (../Sun, ../Moon,
; ../WorldEnvironment), so as long as those node names match this
; just works.
script = ExtResource("7_daynight")

[node name="Sun" type="DirectionalLight3D" parent="." unique_id=1383847949]
; Sun's transform is overwritten every frame by DayNightCycle, so the
; baked basis doesn't matter — only the light_color / light_energy
; defaults below take effect on the very first frame before
; _process runs. DayNightCycle takes over after that.
light_color = Color(1, 0.97, 0.92, 1)
light_energy = 1.4
shadow_enabled = true

[node name="Moon" type="DirectionalLight3D" parent="." unique_id=2000000020]
; The moon. Same DirectionalLight3D as the Sun but cooler, dimmer.
; DayNightCycle keeps it 12 hours behind the Sun so when the Sun
; sets in the west, the Moon rises in the east. Shadows enabled so
; nighttime scenes still cast meaningful shadows from cliffs and
; the player.
light_color = Color(0.55, 0.65, 0.85, 1)
light_energy = 0.0
shadow_enabled = true

[node name="VoxelLodTerrain" type="VoxelLodTerrain" parent="." unique_id=2000000001]
; Scale 0.125 = 1 voxel grid unit renders as 0.125 m in world space,
; which is 8 voxels per meter. CLAUDE.md spec is 8 vox/m (12.5 cm
; voxels). The voxel-grid coordinates stay integer-sized, the visual
; rendering shrinks to fit Godot's metric world.
transform = Transform3D(0.125, 0, 0, 0, 0.125, 0, 0, 0, 0.125, 0, 0, 0)
lod_count = 6
stream = SubResource("VoxelStream_SQLite")
generator = SubResource("VoxelGen_Cubic")
mesher = SubResource("VoxelMesher_Cubes")

[node name="Campfire" type="OmniLight3D" parent="." unique_id=98083291]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -3, 0.5, 0)
light_color = Color(1, 0.55, 0.23, 1)
light_energy = 1.6
shadow_enabled = true
omni_range = 8.0
script = ExtResource("2_flicker")

[node name="CampfireMesh" type="MeshInstance3D" parent="Campfire" unique_id=836077322]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.4, 0)
mesh = SubResource("CampfireMesh")
surface_material_override/0 = SubResource("CampfireMat")

[node name="DialogueTriggerArea" type="Area3D" parent="." unique_id=776679995]
