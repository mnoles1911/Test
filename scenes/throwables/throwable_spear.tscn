[gd_scene load_steps=8 format=3 uid="uid://dthrowablespear01"]

; throwable_spear.tscn — v1 placeholder thrown spear.
;
; Hierarchy:
;   ThrowableSpear (RigidBody3D, root, runs ThrowableSpear.gd)
;   ├── Collision   (CollisionShape3D — capsule, 0.07 m radius, 2.0 m tall)
;   ├── Shaft       (MeshInstance3D — brown wooden box)
;   ├── Head        (MeshInstance3D — iron-grey box at the +Y tip)
;   └── ButtCap     (MeshInstance3D — dark iron box at the -Y end)
;
; Local-axis convention: spear's "forward" is +Y. ThrowableSpear.gd
; rotates this entire root so +Y aligns with the velocity vector
; while in flight, then freezes at impact.
;
; Asset swap path: when assets/voxel/spear.glb lands (per Appendix
; A.2 of the v1 plan), replace the three MeshInstance3D children
; with the imported .glb scene as a single child.

[ext_resource type="Script" path="res://scripts/throwables/ThrowableSpear.gd" id="1_spear"]

[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_spear"]
radius = 0.07
height = 2.0

[sub_resource type="BoxMesh" id="BoxMesh_shaft"]
; Wooden shaft, 14 cm × 1.5 m × 14 cm. Length covers the middle of
; the 2 m spear; head and butt cap fill the remaining 0.5 m.
size = Vector3(0.14, 1.5, 0.14)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_shaft"]
albedo_color = Color(0.42, 0.29, 0.16, 1)
; Mid wood brown (#6B4A2A) per the spear authoring brief.
roughness = 0.85

[sub_resource type="BoxMesh" id="BoxMesh_head"]
; Iron diamond-ish head, narrows to a flat tip. 14 cm × 30 cm × 14 cm.
size = Vector3(0.14, 0.3, 0.14)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_head"]
albedo_color = Color(0.55, 0.55, 0.55, 1)
metallic = 0.7
roughness = 0.4

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_butt"]
albedo_color = Color(0.29, 0.29, 0.29, 1)
metallic = 0.6
roughness = 0.5

[node name="ThrowableSpear" type="RigidBody3D"]
mass = 1.5
contact_monitor = true
max_contacts_reported = 4
script = ExtResource("1_spear")
combat_damage = 30

[node name="Collision" type="CollisionShape3D" parent="."]
shape = SubResource("CapsuleShape3D_spear")

[node name="Shaft" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)
visibility_range_end = 60.0
mesh = SubResource("BoxMesh_shaft")
material_override = SubResource("StandardMaterial3D_shaft")

[node name="Head" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
; Tip end (+Y direction of travel). Box origin at center, so
; offset by half the shaft (0.75) plus half its own height (0.15) = 0.9.
visibility_range_end = 60.0
mesh = SubResource("BoxMesh_head")
material_override = SubResource("StandardMaterial3D_head")

[node name="ButtCap" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.85, 0)
; Tail end (-Y). Smaller than the head; just a 10 cm cap.
visibility_range_end = 60.0
mesh = SubResource("BoxMesh_head")
material_override = SubResource("StandardMaterial3D_butt")
