; Polygon2D is a Node2D subclass, so it lives in world space and moves with its parent.
; Parented under Campfire so position (0,0) = world position (100, 90) = exact light origin.
; This replaces the old ColorRect which was a Control node (screen space) — it drifted
; away from the light center whenever the camera moved with the player.
[node name="CampfireVisual" type="Polygon2D" parent="Campfire"]
color = Color(0.91, 0.53, 0.23, 1)
polygon = PackedVector2Array(-6, -6, 6, -6, 6, 6, -6, 6)

