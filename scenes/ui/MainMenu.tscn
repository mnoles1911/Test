[gd_scene load_steps=2 format=3 uid="uid://dmnmenu1080"]

; MainMenu — the homescreen / title screen.
;
; A standalone 2D scene that closes World3D fully when shown.
; Built for 1920x1080. All UI is constructed programmatically by
; MainMenu.gd in _ready(); this .tscn just provides the root
; Control + a dark background. Building it programmatically keeps
; the layout matched to PauseMenu's style without copy-paste in
; .tscn format.

[ext_resource type="Script" path="res://scripts/MainMenu.gd" id="1_script"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.04, 0.04, 0.06, 1)
