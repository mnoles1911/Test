[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/Settings.gd" id="1"]

; === LAYOUT (320x180 native viewport) ===
;
;  ┌────────────────────────────────┐
;  │  ← SETTINGS                   │  ← header
;  │────────────────────────────────│
;  │  MASTER   [========--]  80%    │
;  │  MUSIC    [=======---]  70%    │
;  │  SFX      [==========]  100%  │
;  │  [x] Fullscreen                │
;  │                                │
;  │  KEYBINDINGS  (coming soon)    │
;  │                                │
;  │  [APPLY]        [BACK]         │
;  └────────────────────────────────┘

[node name="Settings" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.05, 0.05, 0.08, 1.0)

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 0
offset_left = 20.0
offset_top = 10.0
offset_right = 300.0
offset_bottom = 170.0

[node name="Header" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 9
theme_override_colors/font_color = Color(0.9, 0.85, 0.7, 1)
text = "SETTINGS"

[node name="Divider" type="ColorRect" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 1)
color = Color(0.35, 0.35, 0.35, 1)

[node name="Spacer1" type="Control" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 4)

; MASTER VOLUME row.
[node name="MasterRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 14)

[node name="MasterLabel" type="Label" parent="VBox/MasterRow"]
layout_mode = 2
custom_minimum_size = Vector2(60, 0)
theme_override_font_sizes/font_size = 7
theme_override_colors/font_color = Color(0.75, 0.72, 0.65, 1)
text = "MASTER"

[node name="MasterSlider" type="HSlider" parent="VBox/MasterRow"]
layout_mode = 2
size_flags_horizontal = 3
min_value = 0.0
max_value = 1.0
step = 0.05
value = 0.8

; MUSIC VOLUME row.
[node name="MusicRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 14)

[node name="MusicLabel" type="Label" parent="VBox/MusicRow"]
layout_mode = 2
custom_minimum_size = Vector2(60, 0)
theme_override_font_sizes/font_size = 7
theme_override_colors/font_color = Color(0.75, 0.72, 0.65, 1)
text = "MUSIC"

[node name="MusicSlider" type="HSlider" parent="VBox/MusicRow"]
layout_mode = 2
size_flags_horizontal = 3
min_value = 0.0
max_value = 1.0
step = 0.05
value = 0.7

; SFX VOLUME row.
[node name="SFXRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 14)

[node name="SFXLabel" type="Label" parent="VBox/SFXRow"]
layout_mode = 2
custom_minimum_size = Vector2(60, 0)
theme_override_font_sizes/font_size = 7
theme_override_colors/font_color = Color(0.75, 0.72, 0.65, 1)
text = "SFX"

[node name="SFXSlider" type="HSlider" parent="VBox/SFXRow"]
layout_mode = 2
size_flags_horizontal = 3
min_value = 0.0
max_value = 1.0
step = 0.05
value = 1.0

[node name="Spacer2" type="Control" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 6)

; Fullscreen toggle.
[node name="FullscreenCheck" type="CheckBox" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 7
text = "Fullscreen"

[node name="Spacer3" type="Control" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 4)

; Keybindings placeholder.
[node name="KeybindingsLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 7
theme_override_colors/font_color = Color(0.4, 0.4, 0.4, 1)
text = "KEYBINDINGS  (coming soon)"

[node name="Spacer4" type="Control" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3

; Bottom row: Apply + Back.
[node name="ButtonRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2

[node name="ApplyBtn" type="Button" parent="VBox/ButtonRow"]
layout_mode = 2
custom_minimum_size = Vector2(60, 14)
theme_override_font_sizes/font_size = 7
text = "APPLY"
flat = true

[node name="Spacer5" type="Control" parent="VBox/ButtonRow"]
layout_mode = 2
size_flags_horizontal = 3

[node name="BackBtn" type="Button" parent="VBox/ButtonRow"]
layout_mode = 2
custom_minimum_size = Vector2(60, 14)
theme_override_font_sizes/font_size = 7
text = "BACK"
flat = true
