[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/Settings.gd" id="1"]

; === LAYOUT (1080p — VBox centered ~600px wide) ===
;
;          ┌──────────────────────────────────────┐
;          │             SETTINGS                  │
;          │ ───────────────────────────────────── │
;          │ MASTER     [████████░░░░░░░░░░] 80%   │
;          │ MUSIC      [██████████░░░░░░░░] 70%   │
;          │ SFX        [████████████████░░] 100%  │
;          │ ☐ Fullscreen                          │
;          │                                       │
;          │ KEYBINDINGS  (coming soon)            │
;          │                                       │
;          │ [ APPLY ]              [ BACK ]       │
;          └──────────────────────────────────────┘
;
; Settings is a CanvasLayer autoload (layer 60) so it overlays whatever
; scene is currently running without replacing it. This lets MainMenu music
; keep playing while settings are open, and lets PauseMenu share the same
; overlay without a scene transition.
;
; Node paths are preserved verbatim under Root/ so Settings.gd's @onready
; references (Root/VBox/MasterRow/MasterSlider, etc.) resolve correctly.

[node name="Settings" type="CanvasLayer"]
layer = 60
process_mode = 3
script = ExtResource("1")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
process_mode = 3
mouse_filter = 0

[node name="Background" type="ColorRect" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.05, 0.05, 0.08, 1.0)

; VBox sized to a 700×600 panel centered on screen. anchors_preset 8
; (Center) anchors to the screen center, then offsets push the rect
; out by half-width / half-height so it stays centered at any
; resolution.
[node name="VBox" type="VBoxContainer" parent="Root"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -350.0
offset_top = -300.0
offset_right = 350.0
offset_bottom = 300.0
theme_override_constants/separation = 18

[node name="Header" type="Label" parent="Root/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 56
theme_override_colors/font_color = Color(0.95, 0.88, 0.7, 1)
text = "SETTINGS"
horizontal_alignment = 1

[node name="Divider" type="ColorRect" parent="Root/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 2)
color = Color(0.45, 0.4, 0.3, 1)

[node name="Spacer1" type="Control" parent="Root/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 18)

; MASTER VOLUME row.
[node name="MasterRow" type="HBoxContainer" parent="Root/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 56)
theme_override_constants/separation = 24

[node name="MasterLabel" type="Label" parent="Root/VBox/MasterRow"]
layout_mode = 2
custom_minimum_size = Vector2(180, 0)
theme_override_font_sizes/font_size = 30
theme_override_colors/font_color = Color(0.85, 0.82, 0.72, 1)
text = "MASTER"
vertical_alignment = 1

[node name="MasterSlider" type="HSlider" parent="Root/VBox/MasterRow"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
custom_minimum_size = Vector2(0, 32)
min_value = 0.0
max_value = 1.0
step = 0.05
value = 0.8

; MUSIC VOLUME row.
[node name="MusicRow" type="HBoxContainer" parent="Root/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 56)
theme_override_constants/separation = 24

[node name="MusicLabel" type="Label" parent="Root/VBox/MusicRow"]
layout_mode = 2
custom_minimum_size = Vector2(180, 0)
theme_override_font_sizes/font_size = 30
theme_override_colors/font_color = Color(0.85, 0.82, 0.72, 1)
text = "MUSIC"
vertical_alignment = 1

[node name="MusicSlider" type="HSlider" parent="Root/VBox/MusicRow"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
custom_minimum_size = Vector2(0, 32)
min_value = 0.0
max_value = 1.0
step = 0.05
value = 0.7

; SFX VOLUME row.
[node name="SFXRow" type="HBoxContainer" parent="Root/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 56)
theme_override_constants/separation = 24

[node name="SFXLabel" type="Label" parent="Root/VBox/SFXRow"]
layout_mode = 2
custom_minimum_size = Vector2(180, 0)
theme_override_font_sizes/font_size = 30
theme_override_colors/font_color = Color(0.85, 0.82, 0.72, 1)
text = "SFX"
vertical_alignment = 1

[node name="SFXSlider" type="HSlider" parent="Root/VBox/SFXRow"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
custom_minimum_size = Vector2(0, 32)
min_value = 0.0
max_value = 1.0
step = 0.05
value = 1.0

[node name="Spacer2" type="Control" parent="Root/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 16)

; Fullscreen toggle.
[node name="FullscreenCheck" type="CheckBox" parent="Root/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 48)
theme_override_font_sizes/font_size = 28
theme_override_colors/font_color = Color(0.85, 0.82, 0.72, 1)
text = "  Fullscreen"

[node name="Spacer3" type="Control" parent="Root/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 12)

; MINING ANCHOR row — how the carve box is positioned around the
; voxel under the aim crosshair. See EditToolHandler.MiningAnchor +
; design/MINING_TIME_SCALING.md for the design.
[node name="MiningAnchorRow" type="HBoxContainer" parent="Root/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 56)
theme_override_constants/separation = 24

[node name="MiningAnchorLabel" type="Label" parent="Root/VBox/MiningAnchorRow"]
layout_mode = 2
custom_minimum_size = Vector2(280, 0)
theme_override_font_sizes/font_size = 28
theme_override_colors/font_color = Color(0.85, 0.82, 0.72, 1)
text = "MINING ANCHOR"
vertical_alignment = 1

[node name="MiningAnchorBtn" type="Button" parent="Root/VBox/MiningAnchorRow"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 48)
theme_override_font_sizes/font_size = 22
theme_override_colors/font_color = Color(0.7, 0.95, 0.7, 1)
text = "Depth-biased (into terrain)  ✓ DEFAULT"
flat = true

[node name="Spacer3b" type="Control" parent="Root/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 12)

; STREAMING THREADS row — how many CPU cores Zylann uses to stream
; voxel chunks. Higher = faster LOD loading while moving, more CPU
; load. Capped at OS.get_processor_count() at runtime.
[node name="StreamingThreadsRow" type="HBoxContainer" parent="Root/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 56)
theme_override_constants/separation = 24

[node name="StreamingThreadsLabel" type="Label" parent="Root/VBox/StreamingThreadsRow"]
layout_mode = 2
custom_minimum_size = Vector2(280, 0)
theme_override_font_sizes/font_size = 28
theme_override_colors/font_color = Color(0.85, 0.82, 0.72, 1)
text = "STREAMING THREADS"
vertical_alignment = 1

[node name="StreamingThreadsSlider" type="HSlider" parent="Root/VBox/StreamingThreadsRow"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
custom_minimum_size = Vector2(0, 32)
min_value = 1.0
max_value = 32.0
step = 1.0
value = 4.0

[node name="StreamingThreadsValue" type="Label" parent="Root/VBox/StreamingThreadsRow"]
layout_mode = 2
custom_minimum_size = Vector2(64, 0)
theme_override_font_sizes/font_size = 26
theme_override_colors/font_color = Color(0.7, 0.95, 0.7, 1)
text = "4"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Spacer3c" type="Control" parent="Root/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 12)

; Keybindings placeholder.
[node name="KeybindingsLabel" type="Label" parent="Root/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
theme_override_colors/font_color = Color(0.5, 0.48, 0.42, 1)
text = "KEYBINDINGS  (coming soon)"

; Spring spacer pushes the button row to the bottom of the panel.
[node name="Spacer4" type="Control" parent="Root/VBox"]
layout_mode = 2
size_flags_vertical = 3

; Bottom row: Apply + Back.
[node name="ButtonRow" type="HBoxContainer" parent="Root/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 64)
theme_override_constants/separation = 24

[node name="ApplyBtn" type="Button" parent="Root/VBox/ButtonRow"]
layout_mode = 2
custom_minimum_size = Vector2(220, 60)
theme_override_font_sizes/font_size = 28
theme_override_colors/font_color = Color(0.7, 0.95, 0.7, 1)
text = "APPLY"
flat = true

[node name="Spacer5" type="Control" parent="Root/VBox/ButtonRow"]
layout_mode = 2
size_flags_horizontal = 3

[node name="BackBtn" type="Button" parent="Root/VBox/ButtonRow"]
layout_mode = 2
custom_minimum_size = Vector2(220, 60)
theme_override_font_sizes/font_size = 28
theme_override_colors/font_color = Color(0.85, 0.82, 0.72, 1)
text = "SAVE & LEAVE"
flat = true
