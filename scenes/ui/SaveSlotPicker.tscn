[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/SaveSlotPicker.gd" id="1"]

; === LAYOUT (320x180 native viewport) ===
;
;  ┌────────────────────────────────┐
;  │  — SAVE GAME —                 │  ← header (updated by script to LOAD GAME)
;  │────────────────────────────────│
;  │  SLOT 1  [2026-04-30 12:00]    │  ← slot rows (built by script)
;  │          Aldenholt             │
;  │                        [SAVE]  │
;  │  SLOT 2  Empty         [SAVE]  │
;  │  SLOT 3  Empty         [SAVE]  │
;  │                                │
;  │                        [BACK]  │
;  └────────────────────────────────┘

[node name="SaveSlotPicker" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.05, 0.05, 0.08, 1.0)

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 0
offset_left = 20.0
offset_top = 12.0
offset_right = 300.0
offset_bottom = 168.0

[node name="Header" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 9
theme_override_colors/font_color = Color(0.9, 0.85, 0.7, 1)
text = "— SAVE GAME —"

[node name="Divider" type="ColorRect" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 1)
color = Color(0.35, 0.35, 0.35, 1)

[node name="Spacer1" type="Control" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 6)

; Slot rows are built programmatically by SaveSlotPicker.gd._build_slot_rows().
[node name="SlotRows" type="VBoxContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="Spacer2" type="Control" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 6)

[node name="BackBtn" type="Button" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 14)
theme_override_font_sizes/font_size = 7
text = "BACK"
flat = true
