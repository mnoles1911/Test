[gd_scene load_steps=5 format=3 uid="uid://dwatervolume_001"]

[ext_resource type="Script" path="res://scripts/WaterVolume.gd" id="1_water"]
[ext_resource type="ShaderMaterial" path="res://assets/shaders/water_material.tres" id="2_water_mat"]

[sub_resource type="BoxShape3D" id="WaterShape"]
size = Vector3(10, 3.5, 10)

[sub_resource type="PlaneMesh" id="WaterMesh"]
size = Vector2(10, 10)
subdivide_width = 16
subdivide_depth = 16

[node name="WaterVolume" type="Area3D" groups=["water_volume"]]
; A reusable water region. Drop instances of this scene into any
; world to create a swimmable area. Set surface_y to match the top
; of the collision shape (default Y=1.5 puts the surface 1.5m above
; the volume's origin).
script = ExtResource("1_water")
surface_y = 1.5

[node name="ZoneShape" type="CollisionShape3D" parent="."]
; Volume the player must enter to count as "in water". 10x3.5x10 box
; centered at the Area3D origin — height bumped from 3 to 3.5m to
; clear the wave-crest displacement so the player still registers
; as "in water" at peak amplitude.
shape = SubResource("WaterShape")

[node name="SurfaceMesh" type="MeshInstance3D" parent="."]
; Visual of the water surface. Sits at the top of the collision
; volume so it visually matches surface_y above. PlaneMesh with
; 16x16 subdivisions (~280 verts) so the water shader's vertex
; displacement actually has vertices to move.
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.5, 0)
mesh = SubResource("WaterMesh")
material_override = ExtResource("2_water_mat")
