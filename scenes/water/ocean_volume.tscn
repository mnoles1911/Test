[gd_scene load_steps=4 format=3 uid="uid://docean_volume_001"]

[ext_resource type="Script" path="res://scripts/WaterVolume.gd" id="1_water"]
[ext_resource type="ShaderMaterial" path="res://assets/shaders/water_material.tres" id="2_water_mat"]

[sub_resource type="BoxShape3D" id="OceanShape"]
; Big horizontal slab — 200×30×200 m. Vertically goes 15 m below sea
; level (where Roland is fully submerged) up to 15 m above (so the
; ocean still "owns" anyone who somehow ends up below the surface
; on terrain near the edge).
size = Vector3(200, 30, 200)

[sub_resource type="PlaneMesh" id="OceanSurfaceMesh"]
; 200×200 m plane at sea level. Subdivided 32×32 (~1100 verts) so the
; water shader's vertex displacement has enough vertices to make the
; wave pattern read across the whole ocean.
size = Vector2(200, 200)
subdivide_width = 32
subdivide_depth = 32

[node name="OceanVolume" type="Area3D" groups=["water_volume"]]
; Large, ambient ocean. Sea level at world Y=8 — just below the
; average terrain elevation (~Y=10 with current height_offset_voxels=80).
; Result: water is visibly present across roughly a third of the
; world (low ground floods; ridges and plateaus stay dry). Drop
; surface_y and both ZoneShape / SurfaceMesh offsets together
; when retuning — the three numbers must agree.
script = ExtResource("1_water")
surface_y = 8.0

[node name="ZoneShape" type="CollisionShape3D" parent="."]
; Trigger box top sits at world Y=8 (sea level). 30m-tall shape
; offset Y=-7 → spans Y in [-22, 8]. Top of box matches surface_y
; above; bottom is 22m underwater so the player can dive without
; punching through the trigger.
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -7, 0)
shape = SubResource("OceanShape")

[node name="SurfaceMesh" type="MeshInstance3D" parent="."]
; Visible water plane at sea level (world Y=8). PlaneMesh's surface
; is perpendicular to +Y by default, so no rotation needed.
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 8, 0)
mesh = SubResource("OceanSurfaceMesh")
material_override = ExtResource("2_water_mat")
